{
  "name": "@libraz/mysql-event-stream",
  "version": "1.8.0",
  "description": "MySQL 8.4+ / MariaDB 10.11+ CDC engine - Node.js binding (native N-API)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/",
    "build/Release/*.node",
    "LICENSE",
    "licenses/"
  ],
  "scripts": {
    "build:native": "cmake-js compile",
    "build:native:release": "cmake-js rebuild --CDMES_BUNDLE_DEPENDENCIES=ON",
    "build:js": "tsc",
    "build": "npm run build:native && npm run build:js",
    "build:release": "npm run build:native:release && npm run build:js",
    "check:linkage": "bash scripts/check-addon-linkage.sh",
    "check": "biome check src/ tests/",
    "check:fix": "biome check --write src/ tests/",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && tsc --noEmit -p e2e/tsconfig.json",
    "test": "vitest run",
    "test:ci": "../../scripts/run-suite-guarded.sh --runner=vitest npm run test",
    "test:e2e": "../../scripts/run-suite-guarded.sh --runner=vitest vitest run --config e2e/vitest.config.ts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build:release && npm run check:linkage && npm run check && npm run test:ci",
    "prepack": "cp README.md .readme-backup && cp README.npm.md README.md && cp ../../LICENSE LICENSE && cp -R ../../licenses licenses",
    "postpack": "mv .readme-backup README.md && rm -rf LICENSE licenses"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/libraz/mysql-event-stream.git",
    "directory": "bindings/node"
  },
  "homepage": "https://github.com/libraz/mysql-event-stream",
  "bugs": "https://github.com/libraz/mysql-event-stream/issues",
  "keywords": [
    "mysql",
    "mariadb",
    "cdc",
    "binlog",
    "replication",
    "change-data-capture",
    "napi"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "cmake-js": "^8.0.0",
    "mysql2": "^3.24.6",
    "node-addon-api": "^8.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
